# Copy to .env and adjust. All values have sane defaults in src/fraudlake/config.py.
FRAUDLAKE_PG_HOST=localhost
FRAUDLAKE_PG_PORT=5439
FRAUDLAKE_PG_DB=fraudlake
FRAUDLAKE_PG_USER=fraudlake
FRAUDLAKE_PG_PASSWORD=fraudlake
FRAUDLAKE_MLFLOW_TRACKING_URI=sqlite:///data/artifacts/mlflow.db
# Kaggle: place kaggle.json in ~/.kaggle/ (chmod 600) or set KAGGLE_USERNAME / KAGGLE_KEY
